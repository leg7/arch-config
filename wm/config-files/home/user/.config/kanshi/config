profile docked-stat {
	output eDP-1 disable
	output "GIGA-BYTE *" {
		enable
	}
	exec yambar-reload
	exec idle --docked
}

profile dan {
	output "Shenzhen *" {
		enable
		mode 2560x1440@180
	}
	exec yambar-reload
}

profile nomad {
	output "AU Optronics *" enable
	exec yambar-reload
	exec antenna -c wlan
	exec idle
}
